---
import Layout from "../layouts/Layout.astro";
import List from "../components/List.astro";
import TimeView from "../components/TimeView.astro";

// Initial empty list - will be populated client-side from the worker
const list = [];
---

<Layout title="rss">
    <main>
        <TimeView />
        <List list={list} />
    </main>
</Layout>

<style>
    main {
        padding: 2rem;
    }
</style>

<style is:global>
    .link-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        list-style: none;
    }
    .link-card p {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin: 0;
    }
    .link-card a {
        display: inline-flex;
        align-items: center;
        color: var(--text);
        text-decoration: none;
    }
    .link-card a:hover {
        text-decoration: underline;
    }
</style>

<script>
    const WORKER_URL = "https://rss-worker.smmai.workers.dev";
    
    interface FeedItem {
        category: "DEV" | "TECH" | "NEWS" | "TV";
        feed?: string;
        title?: string;
        href?: string;
        date?: string;
    }

    function formatDate(dateString?: string): string {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString();
    }

    function createFeedItemHTML(item: FeedItem): string {
        return `
            <li class="link-card" data-category="${item.category}">
                <p>
                    <small>${formatDate(item.date)}</small>
                    ${item.feed || ''}
                </p>
                <a href="${item.href || '#'}">
                    ${item.title || 'Untitled'}
                </a>
            </li>
        `;
    }

    async function loadFeeds() {
        const listContainer = document.querySelector('ul');
        if (!listContainer) return;

        try {
            const response = await fetch(WORKER_URL);
            if (!response.ok) throw new Error('Failed to fetch feeds');

            const feeds: FeedItem[] = await response.json();
            listContainer.innerHTML = feeds.map(createFeedItemHTML).join('');

            console.log(`Loaded ${feeds.length} feed items`);
        } catch (error) {
            console.error('Error loading feeds:', error);
            listContainer.innerHTML = '<li style="color: red;">Failed to load feeds. Please try again later.</li>';
        }
    }

    // Load feeds on page load
    loadFeeds();
</script>
